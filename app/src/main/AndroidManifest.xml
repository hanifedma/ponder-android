<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- A thought sits in the notification shade; swiping it away brings up the
         next one. Android 13+ asks the user before the first one can be shown. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- A notification does not survive a reboot, so it has to be put back. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The optional keep-alive service (Settings → Keep running in background):
         it is what makes the thought survive a swipe out of recent apps on
         phones that kill the process outright. specialUse is the honest type —
         nothing here is a media, location or data-sync workload. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Lets Settings offer the one-tap "don't put Ponder to sleep" dialog. The
         app only ever asks; the exemption is granted by the person, not taken. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".PonderApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Ponder">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Ponder.Splash"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share any selected text from another app straight into the
                 composer — the native counterpart to pasting into the web form. -->
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Keeps Ponder alive so the thought comes back after a reboot and
             survives a swipe out of recents. stopWithTask="false" is what makes
             the swipe deliver onTaskRemoved instead of simply ending the
             service. It is a safety net only: the notification and its dismissal
             loop work with this service off, blocked or killed. -->
        <service
            android:name=".notify.ThoughtService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps one of the user's own saved quotes in the notification shade and replaces it the moment it is dismissed." />
        </service>

        <!-- Reached only through the notification's own delete PendingIntent, so
             it needs no intent filter and stays unexported. -->
        <receiver
            android:name=".notify.ThoughtReceiver"
            android:exported="false" />

        <!-- The home-screen widget. Exported because the launcher lives in
             another process and has to be able to reach it; APPWIDGET_UPDATE is
             a protected broadcast, and the shuffle action arrives only through
             the widget's own PendingIntent. -->
        <receiver
            android:name=".widget.PonderWidget"
            android:label="@string/widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ponder_widget_info" />
        </receiver>

        <!-- Exported because that is the only way to be handed BOOT_COMPLETED.
             Every action below is a protected broadcast — the system is the only
             sender there is. -->
        <receiver
            android:name=".notify.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
