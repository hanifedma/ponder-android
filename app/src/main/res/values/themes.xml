<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base window theme. Compose paints everything, so this only needs to set
         a window background that matches the app's default (dark) palette;
         MainActivity swaps it at startup if the user chose light mode. -->
    <style name="Theme.Ponder" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_dark</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Shown for the moment between launch and the first Compose frame — the
         native equivalent of the web app's ❝ boot screen. -->
    <style name="Theme.Ponder.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Ponder</item>
    </style>
</resources>
