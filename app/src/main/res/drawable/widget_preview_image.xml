<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget picker's thumbnail on Android 11 and older, which have no
  previewLayout. Drawn rather than screenshotted so it stays a few hundred bytes
  and never goes stale: a dark card, the quotation mark, three lines standing in
  for a quote, and the shuffle button in the app's accent green.

  4:2 to match the widget's default cell shape (250 x 125 units).
-->
<!-- Larger than lint's 200dp guideline on purpose: this is drawn once, in the
     widget picker, and never as an icon in a list. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="VectorRaster"
    android:width="250dp"
    android:height="125dp"
    android:viewportWidth="250"
    android:viewportHeight="125">

    <!-- Card -->
    <path
        android:fillColor="#1A1A1A"
        android:strokeColor="#333333"
        android:strokeWidth="1"
        android:pathData="M8,0.5 L242,0.5 A7.5,7.5 0 0 1 249.5,8 L249.5,117 A7.5,7.5 0 0 1 242,124.5 L8,124.5 A7.5,7.5 0 0 1 0.5,117 L0.5,8 A7.5,7.5 0 0 1 8,0.5 Z" />

    <!-- The ❝ mark, standing in for the section label -->
    <group
        android:scaleX="0.20"
        android:scaleY="0.20"
        android:translateX="14"
        android:translateY="24">
        <path
            android:fillColor="#A6A6A6"
            android:pathData="M24,20 c-7,0 -12,5 -12,12 0,7 5,12 11,12 1.6,0 3,-0.3 3,-0.3 -2,3 -5,4.6 -9,5.2 l1.4,4.4 C25,63 33,55 33,42 33,29 30,20 24,20 Z" />
        <path
            android:fillColor="#A6A6A6"
            android:pathData="M50,20 c-7,0 -12,5 -12,12 0,7 5,12 11,12 1.6,0 3,-0.3 3,-0.3 -2,3 -5,4.6 -9,5.2 l1.4,4.4 C51,63 59,55 59,42 59,29 56,20 50,20 Z" />
    </group>

    <!-- Shuffle button -->
    <path
        android:fillColor="#202021"
        android:pathData="M218,32 m-18,0 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0" />
    <group
        android:scaleX="0.9167"
        android:scaleY="0.9167"
        android:translateX="207"
        android:translateY="21">
        <path
            android:fillColor="#22C55E"
            android:pathData="M10.59,9.17L5.41,4 4,5.41l5.17,5.17 1.42,-1.41zM14.5,4l2.04,2.04L4,18.59 5.41,20 17.96,7.46 20,9.5V4h-5.5zM14.83,13.41l-1.41,1.41 3.13,3.13L14.5,20H20v-5.5l-2.04,2.04 -3.13,-3.13z" />
    </group>

    <!-- Three lines of quote, the last one short as a real one would be -->
    <path android:fillColor="#F0F0F0" android:pathData="M14,58 h222 v7 h-222 z" />
    <path android:fillColor="#F0F0F0" android:pathData="M14,73 h222 v7 h-222 z" />
    <path android:fillColor="#F0F0F0" android:pathData="M14,88 h132 v7 h-132 z" />

    <!-- Source -->
    <path android:fillColor="#6F6F6F" android:pathData="M14,104 h74 v6 h-74 z" />
</vector>
