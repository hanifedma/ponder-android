<?xml version="1.0" encoding="utf-8"?>
<!-- The light card. Solid rather than translucent: a quote has to stay legible
     over whatever wallpaper happens to be behind it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <stroke android:width="1dp" android:color="#E5E7EB" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
